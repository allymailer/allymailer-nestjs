{
  "name": "@allymailer/nestjs",
  "version": "1.1.1",
  "description": "AllyMailer Web API for NestJS: API client module, webhooks, Nodemailer transport",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@allymailer/allymailer-node-sdk": "^2.1.1"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "reflect-metadata": "*"
  },
  "keywords": [
    "allymailer",
    "nestjs",
    "email",
    "nodemailer",
    "webhook"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allymailer/allymailer-nestjs.git"
  },
  "homepage": "https://docs.allymailer.com.ua/ua/web-api-ref"
}
